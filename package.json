    "description": "Print service for customers",
    "private": true,
    "author": "Nadiia Salabutina <nadiya.tita@gmail.com>",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --host 0.0.0.0 --port 4200",
        "build": "ng build",
        "build:prod": "ng build --configuration production",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
